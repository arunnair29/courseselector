# Copy this file to .env.local (already gitignored via the *.local rule)
# and fill in the values from your Supabase project dashboard:
# Project Settings -> API.
#
# VITE_SUPABASE_URL is the "Project URL".
# VITE_SUPABASE_ANON_KEY is the "anon public" API key.
# Both are safe to expose in client-side code — they only grant what your
# Row Level Security policies in supabase/schema.sql allow.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
